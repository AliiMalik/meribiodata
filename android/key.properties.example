# Copy to android/key.properties and fill in. That file is gitignored and must
# stay that way — it holds the passwords to the upload key.
#
# Create the keystore once, and then back it up somewhere you will still have
# in five years:
#
#   keytool -genkey -v -keystore upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Guard it, but know the actual failure mode. With Play App Signing — the
# default for new apps — Google holds the *app signing* key and this is only the
# *upload* key, so losing it means asking support to register a new one rather
# than losing the app forever. Without Play App Signing there is no recovery at
# all: the app could never be updated under safarnamastudios.meribiodata.app
# again, by anyone.
#
# Back up three things or it is not a backup: the .jks file, the password, and
# the alias.

storePassword=
keyPassword=
keyAlias=upload

# Relative to the android/ directory, or absolute. Keep the .jks outside the
# repository.
storeFile=../../upload-keystore.jks
